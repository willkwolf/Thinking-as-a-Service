{
  "name": "thinking-as-a-service",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "dev": "npm run sync-assets && vite",
    "build": "npm run sync-assets && tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "npm run test:vibium",
    "test:vibium": ".venv\\Scripts\\pytest.exe tests/e2e/test_landing_vibium.py",
    "test:playwright": ".venv\\Scripts\\pytest.exe tests/e2e/test_landing_fallback.py",
    "test:all": ".venv\\Scripts\\pytest.exe tests/e2e/",
    "test:gate": "npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
